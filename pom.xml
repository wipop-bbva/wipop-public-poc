<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>es.wipop</groupId>
	<artifactId>wipop-public-poc</artifactId>
	<version>1.0.0</version>

	<name>wipop-public-poc</name>
	<description>Descripción de tu proyecto</description>
  	<url>https://github.com/wipop-bbva/wipop-public-poc</url>

	<licenses>
    	<license>
      		<name>The Apache License, Version 2.0</name>
      		<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      		<distribution>repo</distribution>
    	</license>
  	</licenses>

	<scm>
    	<url>https://github.com/wipop-bbva/wipop-public-poc</url>
    	<connection>scm:git:git://github.com/wipop-bbva/wipop-public-poc.git</connection>
    	<developerConnection>scm:git:ssh://github.com/wipop-bbva/wipop-public-poc.git</developerConnection>
    	<tag>HEAD</tag>
  	</scm>

	<developers>
    	<developer>
      		<id>tu-mrivas</id>
      		<name>Marco Antonio Rivas</name>
      		<email>marcoantonio.rivas@openpay.mx</email>
    	</developer>
  	</developers>

	<distributionManagement>
   		<snapshotRepository>
      		<id>ossrh</id>
      		<url>https://s01.oss.sonatype.org/content/repositories/snapshots/</url>
    	</snapshotRepository>
    	<repository>
      		<id>ossrh</id>
      		<url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
    	</repository>
  	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
	</properties>

	<dependencies>

	</dependencies>

	<build>
  		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>8</source>
					<target>8</target>
				</configuration>
			</plugin>
    		<plugin>
      			<groupId>org.apache.maven.plugins</groupId>
      			<artifactId>maven-gpg-plugin</artifactId>
      			<version>3.0.1</version>
      			<executions>
        			<execution>
          				<id>sign-artifacts</id>
          				<phase>deploy</phase>
          				<goals>
            				<goal>sign</goal>
          				</goals>
        			</execution>
      			</executions>
    		</plugin>
			<plugin>
  				<groupId>org.apache.maven.plugins</groupId>
  				<artifactId>maven-deploy-plugin</artifactId>
  				<version>3.1.1</version>
			</plugin>
  		</plugins>
	</build>

</project>
